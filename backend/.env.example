# ---------------------------------------------------------------------------
# KUN Glass & Aluminium - Backend API
# Copy to `.env` for local development. NEVER commit a real .env.
#
# DO NOT copy your local .env into Render. Production requires the different
# values listed in the PRODUCTION section below.
# ---------------------------------------------------------------------------

# ===========================================================================
# PRODUCTION (Render) - use these values
# ===========================================================================
# NODE_ENV=production
# PORT                        DO NOT SET THIS. Render injects its own PORT.
#                             Setting it breaks Render's routing/health checks.
# CLIENT_URL=https://kun-glassesweb.vercel.app    (no trailing slash)
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# JWT_SECRET=<openssl rand -base64 48>
# IMAGEKIT_PUBLIC_KEY=<actual>
# IMAGEKIT_PRIVATE_KEY=<actual>
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<id>
#
# NOTE: the API also treats RENDER=true as production, so cookies stay
# SameSite=None; Secure even if NODE_ENV is missing. Set NODE_ENV=production
# anyway - it is the documented value and keeps logs/Express behaviour correct.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
# Production: production   |   Local: development
NODE_ENV=development
# Local only. On Render, leave PORT unset so the platform can assign it.
PORT=5000
# Allowed CORS origin(s). Comma-separate to allow preview deploys.
# In production this MUST be the Vercel URL, otherwise the browser's
# cross-site login request is rejected.
CLIENT_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Production: your MongoDB Atlas SRV string.
MONGODB_URI=mongodb://127.0.0.1:27017/kun_glass

# --- Auth ------------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
BCRYPT_ROUNDS=10

# --- Media (ImageKit) ------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- Email (optional) ------------------------------------------------------
# If these are absent the API still runs; enquiry emails are simply skipped.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=no-reply@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
MAX_UPLOAD_FILES=10

# --- Seeding (manual only) -------------------------------------------------
# The seeder NEVER runs automatically. Run it by hand when needed:
#     npm run seed
#
# SEED_ADMIN_PASSWORD is REQUIRED by the seeder; there is no default password.
SEED_ADMIN_EMAIL=admin@kunglass.com
SEED_ADMIN_PASSWORD=<a_strong_initial_admin_password>
# Set to true ONLY when you deliberately want to reset an existing admin's
# password. Left false/unset, an existing admin is never modified.
#     SEED_ADMIN_RESET_PASSWORD=true npm run seed
SEED_ADMIN_RESET_PASSWORD=false

# --- Optional tuning -------------------------------------------------------
# Fail fast if Atlas is unreachable instead of hanging the deploy.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000
